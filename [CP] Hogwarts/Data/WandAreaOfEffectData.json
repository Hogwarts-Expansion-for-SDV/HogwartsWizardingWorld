        },
        "{{ModId}}_HogsmeadeVillageCrossroadFlooFlameRectangle": {
          "Locations": [
            "{{ModId}}_HogsmeadeVillage"
          ],
          "Layers": [
            "Back"
          ],
          "Rectangles": [
            {
              "X": 19,
              "Y": 112,
              "Width": 12,
              "Height": 11
            }
          ],
          "Actions": [
            {
              "LogName": "Hogsmeade Village Crossroad Floo Flame Rectangle Mail",
              "Key": "DMT/mail",
