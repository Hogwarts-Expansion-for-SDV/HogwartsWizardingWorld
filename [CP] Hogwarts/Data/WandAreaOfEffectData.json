          "MarkActionApplied": false,
          "SkipPermanentlyCondition": "PLAYER_HAS_MAIL Current {{ModId}}_HogsmeadeVillageCrossroadFlooFlame Received"
        },
        "{{ModID}}_HogwartsValleyFlooFlame": {
