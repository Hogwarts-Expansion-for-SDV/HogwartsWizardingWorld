          "Id": "{{ModID}}_FlooFlameMailReset",
          "Condition": "ANY \"PLAYER_HAS_MAIL Current {{ModId}}_HogsmeadeVillageCenterFlooFlameRectangle\" \"PLAYER_HAS_MAIL Current {{ModId}}_HogsmeadeVillageCrossroadFlooFlameRectangle\" \"PLAYER_HAS_MAIL Current {{ModId}}_HogwartsValleyFlooFlame\" \"PLAYER_HAS_MAIL Current {{ModId}}_HogwartsValleyIncendio\"",
          "Trigger": "LocationChanged",
