        "{{ModId}}_Reducto": {
          "DisplayName": "Reducto",
          "Sequence": [
            "DownRight",
            "DownLeft"
          ],
          "SetSound": "fairy_heal",
          "SpellLevels": [
            {
              "TriggerAction": "AddMail Current {{ModId}}_HogsmeadeVillageCenterIncendio received"
            }
          ]
        }
      },
      "When": {
        "HasMod |contains= aedenthorn.AreaOfEffect": true
