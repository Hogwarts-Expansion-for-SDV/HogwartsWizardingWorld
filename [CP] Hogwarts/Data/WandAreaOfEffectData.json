          "Trigger": "Esca.EMP_OneSecondUpdateTicked",
          "Action": "AddMail Current {{ModId}}_HogwartsValleyFlooFlame Received",
          "MarkActionApplied": false,
          "SkipPermanentlyCondition": "PLAYER_HAS_MAIL Current {{ModId}}_HogwartsValleyFlooFlame Received"
