      }
    },
    {
      "LogName": "Hogwarts Area of Effect Tools",
      "Action": "EditData",
      "Target": "aedenthorn.AreaOfEffect/tools",
      "Entries": {
        "{{ModId}}_{{Wand}}Wand": {
          "RechargeSound": "cowboy_powerup",
          "Spells": [
            "{{ModId}}_Incendio",
            "{{ModId}}_Reducto"
          ]
        }
      },
      "When": {
        "HasMod |contains= aedenthorn.AreaOfEffect": true,
        "Spellcasting": true
      }
    }
  ]
}