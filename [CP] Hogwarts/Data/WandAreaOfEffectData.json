            "RemoveMail Current {{ModId}}_HogsmeadeVillageCenterFlooFlameRectangle",
            "RemoveMail Current {{ModId}}_HogsmeadeVillageCrossroadFlooFlameRectangle",
            "RemoveMail Current {{ModId}}_HogsmeadeVillageIncendio",
            "RemoveMail Current {{ModId}}_HogwartsValleyFlooFlameRectangle",
            "RemoveMail Current {{ModId}}_HogwartsValleyIncendio"
          ],
          "MarkActionApplied": false
        }
