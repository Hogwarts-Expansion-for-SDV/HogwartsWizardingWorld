              "Width": 17,
              "Height": 11
            }
          ],
          "Actions": [
            {
              "LogName": "Hogsmeade Village Center Floo Flame Rectangle Mail",
              "Key": "DMT/mail",
              "Value": "{{ModId}}_HogsmeadeVillageCenterFlooFlameRectangle",
