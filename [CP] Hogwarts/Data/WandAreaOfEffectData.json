    {
      "LogName": "Hogwarts Charms Trigger Actions",
      "Action": "EditData",
      "Target": "Data/TriggerActions",
      "Entries": {
        // Reset
        "{{ModID}}_CharmsMailReset": {
          "Id": "{{ModID}}_CharmsMailReset",
          "Condition": null,
          "Trigger": "LocationChanged",
          "Actions": [
            "RemoveMail Current {{ModId}}_HogsmeadeVillageCenterFlooFlameRectangle",
            "RemoveMail Current {{ModId}}_HogsmeadeVillageCrossroadFlooFlameRectangle",
            "RemoveMail Current {{ModId}}_HogsmeadeVillageIncendio",
            "RemoveMail Current {{ModId}}_HogwartsValleyFlooFlameRectangle",
            "RemoveMail Current {{ModId}}_HogwartsValleyIncendio",
            "RemoveMail Current {{ModId}}_HogsmeadeVillageForbiddenForestEntranceRectangle",
            "RemoveMail Current {{ModId}}_HogsmeadeVillageReducto"
          ],
          "MarkActionApplied": false
        },
        // Reducto
        "{{ModID}}_HogsmeadeVillageForbiddenForestEntranceOpen": {
          "Id": "{{ModID}}_HogsmeadeVillageForbiddenForestEntranceOpen",
          "Condition": "PLAYER_HAS_ITEM Current (W){{ModId}}_{{Wand}}Wand, PLAYER_HAS_MAIL Current {{ModId}}_HogsmeadeVillageReducto, PLAYER_HAS_MAIL Current {{ModId}}_HogsmeadeVillageForbiddenForestEntranceRectangle, !PLAYER_HAS_MAIL Any HogsmeadeVillageForbiddenForestEntranceOpen",
          "Trigger": "Esca.EMP_OneSecondUpdateTicked",
          "Action": "AddMail All {{ModId}}_HogsmeadeVillageForbiddenForestEntranceOpen Received",
          "MarkActionApplied": false
        },
        // Incendio
        "{{ModID}}_HogsmeadeVillageCenterFlooFlame": {
          "Id": "{{ModID}}_HogsmeadeVillageCenterFlooFlame",
          "Condition": "PLAYER_HAS_ITEM Current (W){{ModId}}_{{Wand}}Wand, PLAYER_HAS_MAIL Current {{ModId}}_HogsmeadeVillageIncendio, PLAYER_HAS_MAIL Current {{ModId}}_HogsmeadeVillageCenterFlooFlameRectangle, !PLAYER_HAS_MAIL Current {{ModId}}_HogsmeadeVillageCenterFlooFlame",
          "Trigger": "Esca.EMP_OneSecondUpdateTicked",
          "Action": "AddMail Current {{ModId}}_HogsmeadeVillageCenterFlooFlame Received",
          "MarkActionApplied": false,
          "SkipPermanentlyCondition": "PLAYER_HAS_MAIL Current {{ModId}}_HogsmeadeVillageCenterFlooFlame Received"
        },
        "{{ModID}}_HogsmeadeVillageCrossroadFlooFlame": {
          "Id": "{{ModID}}_HogsmeadeVillageCrossroadFlooFlame",
          "Condition": "PLAYER_HAS_ITEM Current (W){{ModId}}_{{Wand}}Wand, PLAYER_HAS_MAIL Current {{ModId}}_HogsmeadeVillageIncendio, PLAYER_HAS_MAIL Current {{ModId}}_HogsmeadeVillageCrossroadFlooFlameRectangle, !PLAYER_HAS_MAIL Current {{ModId}}_HogsmeadeVillageCrossroadFlooFlame",
