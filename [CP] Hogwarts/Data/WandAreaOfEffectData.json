      "Update": "OnLocationChange"
    },
    {
      "LogName": "Hogwarts Area of Effect Wand Mail",
      "Action": "EditData",
      "Target": "Data/TriggerActions",
      "Entries": {
        "{{ModID}}_HogsmeadeVillageCenter": {
          "Id": "{{ModID}}_HogsmeadeVillageCenter",
          "Condition": "PLAYER_HAS_ITEM Current (W){{ModId}}_{{Wand}}Wand, PLAYER_HAS_MAIL Current {{ModId}}_HogsmeadeVillageIncendio, PLAYER_HAS_MAIL Current {{ModId}}_HogsmeadeVillageCenterFlooFlameRectangle, !PLAYER_HAS_MAIL Current {{ModId}}_HogsmeadeVillageCenterFlooFlame",
          "Trigger": "Esca.EMP_OneSecondUpdateTicked",
          "Action": "AddMail Current {{ModId}}_HogsmeadeVillageCenterFlooFlame Received",
          "MarkActionApplied": false,
          "SkipPermanentlyCondition": "PLAYER_HAS_MAIL Current {{ModId}}_HogsmeadeVillageCenterFlooFlame Received"
        },
        "{{ModID}}_HogsmeadeVillageCrossroad": {
          "Id": "{{ModID}}_HogsmeadeVillageCrossroad",
          "Condition": "PLAYER_HAS_ITEM Current (W){{ModId}}_{{Wand}}Wand, PLAYER_HAS_MAIL Current {{ModId}}_HogsmeadeVillageIncendio, PLAYER_HAS_MAIL Current {{ModId}}_HogsmeadeVillageCrossroadFlooFlameRectangle, !PLAYER_HAS_MAIL Current {{ModId}}_HogsmeadeVillageCrossroadFlooFlame",
          "Trigger": "Esca.EMP_OneSecondUpdateTicked",
          "Action": "AddMail Current {{ModId}}_HogsmeadeVillageCrossroadFlooFlame Received",
          "MarkActionApplied": false,
          "SkipPermanentlyCondition": "PLAYER_HAS_MAIL Current {{ModId}}_HogsmeadeVillageCrossroadFlooFlame Received"
        },
        "{{ModID}}_HogsmeadeVillageCenterReset": {
          "Id": "{{ModID}}_HogsmeadeVillageCenterReset",
          "Condition": "ANY \"PLAYER_HAS_MAIL Current {{ModId}}_HogsmeadeVillageCenterFlooFlameRectangle\" \"PLAYER_HAS_MAIL Current {{ModId}}_HogsmeadeVillageCrossroadFlooFlameRectangle\" \"PLAYER_HAS_MAIL Current {{ModId}}_HogsmeadeVillageIncendio\"",
          "Trigger": "LocationChanged",
          "Actions": [
            "RemoveMail Current {{ModId}}_HogsmeadeVillageCenterFlooFlameRectangle",
            "RemoveMail Current {{ModId}}_HogsmeadeVillageCrossroadFlooFlameRectangle",
            "RemoveMail Current {{ModId}}_HogsmeadeVillageIncendio"
          ],
          "MarkActionApplied": false
        }
      }
    },
    {
      "LogName": "Hogwarts Charms Mail",
