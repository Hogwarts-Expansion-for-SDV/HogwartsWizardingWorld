{
  "Changes": [
    {
      "LogName": "Hogwarts House Emblems Image Load",
      "Action": "Load",
      "Target": "{{ModId}}/HufflepuffEmblem, {{ModId}}/GryffindorEmblem, {{ModId}}/RavenclawEmblem, {{ModId}}/SlytherinEmblem",
      "FromFile": "assets/Objects/Houses/{{TargetWithoutPath}}.png"
    },
    {
      "LogName": "Hogwarts House Point Image Load",
      "Action": "Load",
      "Target": "{{ModId}}/HousePoint",
      "FromFile": "assets/Objects/Galleta_Hxoni.png"
    },
    {
      "LogName": "Hogwarts House Point Objects",
      "Action": "EditData",
      "Target": "Data/Objects",
      "Entries": {
        "{{ModId}}_HousePoint": {
          "Name": "{{ModId}}_HousePoint",
          "DisplayName": "Hogwarts House Point",
          "Description": "Submit these to your house's hourglass.",
          "Texture": "{{ModId}}/HousePoint",
          "SpriteIndex": 0,
          "Type": "Basic",
          "ContextTags": [
            "{{ModId}}_Hogwarts"
          ]
        }
      }
    },
    {
      "LogName": "Hogwarts House Point Objects Wallet Currencies UB",
      "Action": "EditData",
      "Target": "UnlockableBundles/WalletCurrencies",
      "Entries": {
        "{{ModId}}_HousePoint": {
          "Shared": false,
          "DrawOverheadPickupAnimation": false,
          "OverheadPickupTexture": "{{ModId}}/HousePoint",
          "OverheadPickupAnimation": null,
          "OverheadPickupTextureSize": 16,
          "BillboardTexture": "{{ModId}}/HousePoint",
          "BillboardTextureSize": 16,
          "BillboardDigits": 3,
          "PickupSound": "reward",
          "PlayMoneyRollSound": true,
          "Items": [
            {
              "ItemId": "(O){{ModId}}_HousePoint",
              "Value": 1
            }
          ],
          "PowersData": {
            "DisplayName": "Hogwarts House Points",
            "TexturePath": "{{ModId}}/HousePoint",
            "TexturePosition": {
              "X": 0,
              "Y": 0
            }
          }
        }
      },
      "When": {
        "HasMod |contains= DLX.Bundles": true
      }
    },
    {
      "LogName": "Hogwarts House Powers",
      "Action": "EditData",
      "Target": "Data/Powers",
      "Entries": {
        "{{ModId}}_HufflepuffEmblem": {
          "DisplayName": "Hufflepuff Emblem",
