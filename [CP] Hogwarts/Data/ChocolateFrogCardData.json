          "MarkActionApplied": false
        },
        "{{ModId}}_ChocolateFrogDarkEdible": {
          "Id": "{{ModId}}_ChocolateFrogDarkEdible",
          "Condition": "ITEM_ID Input {{ModId}}_ChocolateFrogDark",
          "Trigger": "spacechase0.SpaceCore_OnItemEaten",
          "Action": "AddItem {{ModId}}_{{Random:{{Card}}|key={{Time}}{{PlayerName}}}}",
