      "Action": "EditData",
      "Target": "spacechase0.SpaceCore/ObjectExtensionData",
      "Entries": {
        "{{ModId}}_ChocolateFrogMilk": {
          "UseForTriggerAction": true
        },
        "{{ModId}}_ChocolateFrogWhite": {
          "UseForTriggerAction": true
        },
        "{{ModId}}_ChocolateFrogDark": {
          "UseForTriggerAction": true
        }
      }
    },
    {
      "LogName": "Hogwarts Chocolate Frog Card Trigger Actions",
      "Action": "EditData",
      "Target": "Data/TriggerActions",
      "Entries": {
        "{{ModId}}_ChocolateFrogMilkEdible": {
          "Id": "{{ModId}}_ChocolateFrogMilkEdible",
          "Condition": "ITEM_ID Input {{ModId}}_ChocolateFrogMilk",
          "Trigger": "spacechase0.SpaceCore_OnItemEaten",
          "Action": "AddItem {{ModId}}_{{Random:{{Card}}|key={{Time}}{{PlayerName}}}}",
