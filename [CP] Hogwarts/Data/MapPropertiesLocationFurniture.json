{
  "Changes": [
    {
      "LogName": "Hogwarts Room of Requirement Furniture Shop Action OpenShop",
      "Action": "EditMap",
      "Target": "Maps/{{ModId}}_HogwartsRoomOfRequirement",
      "MapTiles": [
        {
          "Position": {
            "X": 5,
            "Y": 3
          },
          "Layer": "Buildings",
          "SetProperties": {
            "Action": "OpenShop {{ModId}}_Ollivanders"
          }
        }
      ]
    },
    {
      "LogName": "Hogwarts Room of Requirement Furniture Shop DMTE",
      "Action": "EditMap",
      "Target": "Maps/{{ModId}}_HogwartsRoomOfRequirement",
      "MapTiles": [
        {
          "Position": {
            "X": 3,
            "Y": 5
          },
          "Layer": "Back",
          "SetProperties": {
            "DMT/object_Once_Enter": "3,5,(F){{Random:{{HogwartsFurniture}}|key=RoomOfRequirementTopLeft}},false|3,8,(F){{Random:{{HogwartsFurniture}}|key=RoomOfRequirementBottomLeft}},false|7,5,(F){{Random:{{HogwartsFurniture}}|key=RoomOfRequirementTopRight}},false|7,8,(F){{Random:{{HogwartsFurniture}}|key=RoomOfRequirementBottomRight}},false"
          }
        }
      ],
      "When": {
        "HasMod |contains= aedenthorn.DynamicMapTilesExtended": true,
        "HasMod |contains= Spiderbuttons.BETAS": true
      }
    },
    {
      "LogName": "Hogwarts Room of Requirement Trigger Actions Furniture Clear",
      "Action": "EditData",
      "Target": "Data/TriggerActions",
      "Entries": {
        "{{ModId}}_RoomOfRequirementFurnitureClear": {
          "Id": "{{ModId}}_RoomOfRequirementFurnitureClear",
          "Trigger": "DayEnding",
          "Action": "Spiderbuttons.BETAS_ClearObjects {{ModId}}_HogwartsRoomOfRequirement Furniture 0 0 10 10",
          "MarkActionApplied": false
        }
      },
      "When": {
        "HasMod |contains= aedenthorn.DynamicMapTilesExtended": true,
        "HasMod |contains= Spiderbuttons.BETAS": true
      }
    },
    {
      "LogName": "Hogwarts Room of Requirement Unlockable Bundle Left Top",
      "Action": "EditData",
      "Target": "UnlockableBundles/Bundles",
      "Entries": {
        "{{ModId}}_RoomOfRequirement{{Day}}{{Season}}{{Year}}TopLeft": {
          "Location": "{{ModId}}_HogwartsRoomOfRequirement",
          "ShopType": "Dialogue",
          "BundleDescription": "Would you like to purchase this furniture?",
          "ShopEvent": "none",
          "ShopPosition": "2, 5",
          "ShopTexture": "TileSheets/Craftables",
          "ShopTextureSource": {
            "X": 16,
            "Y": 1120,
            "Width": 16,
            "Height": 32
          },
          "DrawQuestionMark": false,
          "QuestionMarkOffset": "24, 32",
          "Price": {
            "{{ModId}}_HousePoint": 1
          },
          "BundleCompletedActions": [
            "AddMail Current {{ModId}}_RoomOfRequirementTopLeft now",
            "spacechase0.SpaceCore_ShowHudMessage \"The furniture will be mailed to your house.\" (F){{Random:{{HogwartsFurniture}}|key=RoomOfRequirementTopLeft}}"
          ],
          "InteractionShake": true,
          "InstantShopRemoval": false
        }
      },
      "When": {
        "HasMod |contains= DLX.Bundles": true,
        "HasMod |contains= spacechase0.SpaceCore": true,
        "HasFlag |contains= {{ModId}}_RoomOfRequirementTopLeft": false
      }
    },
    {
      "LogName": "Hogwarts House Tasks Mail Data",
      "Action": "EditData",
      "Target": "Data/Mail",
      "Entries": {
        "{{ModId}}_RoomOfRequirementTopLeft": "OWL POST%item id (F){{Random:{{HogwartsFurniture}}|key=RoomOfRequirementTopLeft}} 1 %% %action RemoveMail Current {{ModId}}_RoomOfRequirementTopLeft now %%[#]Room of Requirement Furniture Shop",
        "{{ModId}}_RoomOfRequirementBottomLeft": "OWL POST%item id (F){{Random:{{HogwartsFurniture}}|key=RoomOfRequirementBottomLeft}} 1 %%[#]Room of Requirement Furniture Shop",
        "{{ModId}}_RoomOfRequirementTopRight": "OWL POST%item id (F){{Random:{{HogwartsFurniture}}|key=RoomOfRequirementTopRight}} 1 %%[#]Room of Requirement Furniture Shop",
        "{{ModId}}_RoomOfRequirementBottomRight": "OWL POST%item id (F){{Random:{{HogwartsFurniture}}|key=RoomOfRequirementBottomRight}} 1 %%[#]Room of Requirement Furniture Shop"
      }
    },
    {
      "LogName": "Hogwarts Room of Requirement Trigger Actions Remove Mail",
      "Action": "EditData",
      "Target": "Data/TriggerActions",
      "Entries": {
        "{{ModId}}_RoomOfRequirementTopLeft": {
          "Id": "{{ModId}}_RoomOfRequirementTopLeft",
          "Trigger": "DayEnding",
          "Condition": "ANY \"PLAYER_HAS_MAIL Any {{ModId}}_RoomOfRequirementTopLeft Any\" \"PLAYER_HAS_MAIL Any RoomOfRequirement{{Day}}{{Season}}{{Year}}TopLeft Any\"",
          "Actions": [
            "RemoveMail All DLX.Bundles.{{ModId}}_RoomOfRequirement{{Day}}{{Season}}{{Year}}TopLeft"
          ],
          "MarkActionApplied": false
        }
      }
    },
